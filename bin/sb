    ha.add_argument("--install-guards", action="store_true")
    ha.add_argument("--remove-guards", action="store_true")
    ha.add_argument("--list-guards", action="store_true")
    uh = sub.add_parser("unhalt")
    uh.add_argument("--host", action="append")
    rn = sub.add_parser("run")
    rn.add_argument("--name", required=True)
    rn.add_argument("--host")
    rn.add_argument("--threads", type=int, default=1)
    rn.add_argument("--mem", type=float, default=2.0, help="GiB")
    rn.add_argument("--gpu", type=float, help="VRAM in GiB")
    rn.add_argument("--gpu-uuid", help="pin to this card: passed unchanged to the gpu-workboard's submit (needs --gpu)")
    rn.add_argument("--hours", type=float, default=12.0)
    rn.add_argument("--cwd")
    rn.add_argument("--project")
    rn.add_argument("--lane", choices=["batch", "interactive"], default=None, help="default batch; a priority project's jobs default to interactive")
    rn.add_argument("--protected", action="store_true", help="opt out of GPU checkpoint preemption (owner's call)")
    rn.add_argument("command", nargs=argparse.REMAINDER)
    jb = sub.add_parser("jobs")
    jb.add_argument("action", nargs="?", default="list", choices=["list", "show"])
    jb.add_argument("arg", nargs="?")
    jb.add_argument("--all", action="store_true")
    jb.add_argument("--mine", action="store_true")
    jb.add_argument("--project")
    jb.add_argument("--host")
    jb.add_argument("--log", type=int, default=40)
    sp = sub.add_parser("stop")
    sp.add_argument("id")
    sp.add_argument("--reason", default="")
    ad = sub.add_parser("adopt")
    ad.add_argument("target", help="a unit name or a pid")
    ad.add_argument("--name", required=True)
    ad.add_argument("--host")
    ad.add_argument("--project")
    ad.add_argument("--threads", type=int, default=0)
    ad.add_argument("--mem", type=float, default=0.0)
    ad.add_argument("--gpu", type=float)
    ib = sub.add_parser("inbox")
    ib.add_argument("action", nargs="?", default="list", choices=["list", "done", "ignore"])
    ib.add_argument("arg", nargs="?", help="the item id (done, ignore)")
    ib.add_argument("answer", nargs="?", help="the answer (done); none dismisses or acknowledges; ignore tells the agent nothing")
    ib.add_argument("--project")
    ib.add_argument("--json", action="store_true")
    a = sub.add_parser("ask")
    a.add_argument("question")
    a.add_argument("--options", default="")
    a.add_argument("--project")
    r = sub.add_parser("reply")
    r.add_argument("turn")
    r.add_argument("text")
    st = sub.add_parser("status")
    st.add_argument("id")
    args = ap.parse_args()
    if args.cmd == "setup":
        return setup()

    if args.cmd == "agents":
        for x in call("GET", "/api/agents")["agents"]:
            print(f"{x['id']:<28} {x['state']:<9} {x['provider']}/{x['account'] or '-':<8} {x['mode']:<9} "
                  f"{x['project'] or '-':<18} {(x['last_text'] or '').splitlines()[-1][:60] if x['last_text'] else ''}")
    elif args.cmd == "projects":
        for p in call("GET", "/api/overview")["projects"]:
            print(f"{p['id']:<22} {len(p['agent_ids'])} agents  {p['next_step'][:80]}")
    elif args.cmd == "send":
        text = args.text if args.text not in (None, "-") else sys.stdin.read()
        sender = args.frm or me()
        res = call("POST", "/api/messages", {"to": args.to, "body": text, "from": sender,
                                             "idem": os.environ.get("SB_IDEM") or str(uuid.uuid4()),
                                             "wait": args.wait,
                                             "hop": int(os.environ.get("SB_HOP", "-1")) + 1})
        m = res["message"]
        print(f"{m['id']} {m['state']}{' (already sent — not sent again)' if res['duplicate'] else ''}")
        if args.wait:
            end = time.time() + args.timeout
            while time.time() < end:
                m = call("GET", f"/api/messages/{m['id']}")
                if m["state"] in ("done", "failed", "held"):
                    print(m["state"])
                    print(m.get("reply") or m.get("error") or "")
                    return 0 if m["state"] == "done" else 1
                time.sleep(3)
            print("still running; check later with: sb status " + m["id"])
            return 2
    elif args.cmd == "dispatch":
        res = call("POST", "/api/dispatch", {"project": args.project, "task": args.task, "cwd": args.cwd,
                                             "title": args.title, "model": args.model, "from": me(),
                                             "idem": args.idem or str(uuid.uuid4())})
        a = res["agent"]
        print(f"{a['id']} on {a['project']} ({a['model']}, {a['account']})"
              f"{' (already dispatched — not started again)' if res['duplicate'] else ''}")
    elif args.cmd == "sessions":
        q = urllib.parse.urlencode({"q": " ".join(args.query), "limit": args.limit, "headless": int(args.all)})
        res = call("GET", f"/api/sessions?{q}")
        for x in res["sessions"]:
            where = f"agent {x['agent']}" if x["agent"] else (f"-> {x['project']}" if x["project"] else "-> new project")
            what = " ".join((x["title"] or x["first_ask"] or "").split())[:60]
            print(f"{x['id']}  {x['provider']:<6} {(x['last_ts'] or '')[:10]}  {what:<60}  {x['cwd']}  [{where}]")
            if x.get("snippet"):
                print(f"    {' '.join(x['snippet'].split())[:150]}")
        if not res["sessions"]:
            print(f"no match among {res['indexed']} sessions" + (" (still indexing)" if res["indexing"] else ""))
    elif args.cmd == "resume":
        res = call("POST", "/api/sessions/resume", {"session_id": args.session_id, "project": args.project,
                                                     "title": args.title})
        a = res["agent"]
        how = "already an agent" if not res["created"] else (
            "new agent on new project" if res["created_project"] else "new agent")
        print(f"{a['id']} on {a['project']} ({how}); open: [[open:{a['project']}/{a['id']}]]")
    elif args.cmd == "relaunch":
        b = {k: getattr(args, k) for k in ("model", "effort", "provider", "account") if getattr(args, k) is not None}
        a = call("POST", f"/api/agents/{args.agent}/relaunch", dict(b, confirm=args.confirm))
        how = "next turn" if a["mode"] == "managed" else (f"moving to {args.provider} (a new conversation)"
                                                          if args.provider else "relaunching on the same session")
        print(f"{a['id']}: {how} (model {b.get('model') or a['model'] or 'default'}); "
              f"open: [[open:{a['project']}/{a['id']}]]")
    elif args.cmd == "helper":
        r = call("POST", "/api/helpers", {"task": args.task, "minutes": args.minutes, "model": args.model, "from": me()})
        print(f"helper {r['helper']} ({r['model']}) until {r['deadline']}; its result comes back to you as a message")
    elif args.cmd == "helpers":
        for h in call("GET", f"/api/helpers?parent={urllib.parse.quote(me())}")["helpers"]:
            print(f"{h['id']:<24} {h['state']:<9} {h['model']:<18} until {h['deadline'][11:16]}Z  "
                  f"{(h['result'] or ' '.join(h['task'].split())[:60])}")
    elif args.cmd == "subagents":
        q = {"hours": args.hours, "limit": args.limit}
        q.update({k: getattr(args, k) for k in ("model", "agent") if getattr(args, k)})
        res = call("GET", "/api/subagents?" + urllib.parse.urlencode(q))
        for x in res["subagents"]:
            who = (f"agent {x['agent']} ({x['project']})" if x["agent"]
                   else f"session {x['parent_session'][:8]}" + (f" \"{' '.join(x['session_title'].split())[:50]}\""
                                                                  if x["session_title"] else ""))
            state = "done" if x["finished"] else "running?"
            print(f"{(x['started_at'] or '')[:16].replace('T', ' ')}Z  {x['model'] or '-':<18} {state:<8} "
                  f"\"{x['description'][:50]}\"  spawned by {who} [session {x['parent_session']}]  {x['cwd'] or ''}")
        if not res["subagents"]:
            print(f"no subagents in the last {args.hours:g} h" + (f" matching {args.model}" if args.model else ""))
    elif args.cmd == "clear":
        a = call("POST", f"/api/agents/{args.agent}/clear", {})
        print(f"{a['id']} cleared; its next message starts a new conversation")
    elif args.cmd == "reads":
        if args.others or args.none:
            res = call("POST", f"/api/projects/{args.project}/reads", {"reads": [] if args.none else args.others,
                                                                       "tell": not args.quiet})
            print(f"{res['project']} may read: {', '.join(res['reads']) or 'no other project'}"
                  + (f"  (told: {', '.join(res['told'])})" if res["told"] else ""))
            for g in res["grants"]:
                print(f"  {g['id']}: {', '.join(g['folders']) or 'no working folder known'}")
        else:
            p = call("GET", f"/api/projects/{args.project}")
            p = p.get("project") or p
            print(f"{args.project} may read: " + ("every project (outside read access)" if p.get("outside_read") else
                                                   ', '.join(p.get('reads') or []) or 'no other project')
                  + ("; may message other projects' leads (outside write access)" if p.get("outside_write") else
                     "; may not message other projects"))
    elif args.cmd == "outside":
        onoff = lambda v: "on" if v else "off"  # noqa: E731
        if args.read or args.write:
            res = call("POST", f"/api/projects/{args.project}/outside",
                       {"read": None if args.read is None else args.read == "on",
                        "write": None if args.write is None else args.write == "on", "tell": not args.quiet})
            print(f"{res['project']} outside its folder: read {onoff(res['read'])}, write {onoff(res['write'])}"
                  + (f"  (relaunched: {', '.join(res['relaunched'])})" if res["relaunched"] else "")
                  + (f"  (busy, takes it on next start: {', '.join(res['next_start'])})" if res["next_start"] else ""))
        else:
            p = call("GET", f"/api/projects/{args.project}")
            p = p.get("project") or p
            print(f"{args.project} outside its folder: read {onoff(p.get('outside_read'))}, "
                  f"write {onoff(p.get('outside_write'))}")
    elif args.cmd == "context":
        q = {"from": me()}
        if args.agent:
            q.update(n=args.n, tools=int(args.tools))
            print(call("GET", f"/api/agents/{args.agent}/context?{urllib.parse.urlencode(q)}")["text"])
            return 0
        if args.search:
            q["q"] = args.search
        q["notes"] = args.notes
        base = f"/api/projects/{args.project}/context" if args.project else "/api/context"
        res = call("GET", f"{base}?{urllib.parse.urlencode(q)}")
        if args.search:
            for x in res["hits"]:
                print(f"[{(x['ts'] or '')[:16]}] {x['agent']} {'ASKED' if x['role'] == 'user' else 'SAID'}: {x['text']}")
            if not res["hits"]:
                print(f"nothing on project {res['project']} mentions that")
            return 0
        print(f"PROJECT {res['project']}" + (" (read-only for you: look, never send, note or change anything there)"
                                             if res.get("read_only") else "")
              + (f"\nmay read (read-only): {', '.join(res['reads'])}  (sb context --project NAME)"
                 if res.get("reads") and not res.get("read_only") else ""))
        for a in res["agents"]:
            fork = f", fork of {a['forked_from']}" if a["forked_from"] else ""
            print(f"\n{a['id']}{' (you)' if a['you'] else ''} - {a['title']} ({a['provider']} {a['model'] or ''}, "
                  f"{a['state']}{fork})")
            if a["asked"]:
                print(f"  last asked: {a['asked']}")
            if a["said"]:
                print(f"  last said:  {a['said']}")
        if res["notes"]:
            older = (res.get("notes_total") or 0) - len(res["notes"])
            print("\nNOTES" + (f" (the newest {len(res['notes'])}; {older} older: sb context --notes N)" if older > 0 else ""))
            for n in res["notes"]:
                print(f"  [{n['created_at'][:16]}] {n['agent']}: {n['text']}")
        mem = res.get("memory")
        if mem:
            print(f"\nMEMORY: {mem['sessions']} ended conversation{'' if mem['sessions'] == 1 else 's'} on record"
                  + (f", running memory updated {mem['updated_at'][:16]}" if mem.get("updated_at") else "")
                  + "  (sb memory" + (f" --project {res['project']}" if res.get("read_only") else "") + ")")
    elif args.cmd == "memory":
        return memory_cmd(args)
    elif args.cmd in ("wiki", "nodes"):
        frm = urllib.parse.urlencode({"from": me()})
        if args.cmd == "wiki" and args.all:
            v = call("GET", "/api/wiki")
            if args.json:
                print(json.dumps(v, indent=1))
                return 0
            for r in v["projects"]:
                seats = " ".join(f"{k}={a or '-'}" for k, a in r["seats"].items())
                print(f"{r['project']:<28} {(r['last_activity'] or '-')[:16]:<17} {seats}"
                      + (f"  +{r['extras']} outside seats" if r["extras"] else "")
                      + (f"  WAITING ON OWNER x{r['waiting_on_owner']}" if r["waiting_on_owner"] else ""))
            return 0
        pid = args.project or (call("GET", f"/api/context?{frm}&notes=0")["project"])
        if args.cmd == "wiki":
            v = call("GET", f"/api/projects/{pid}/wiki?{frm}" + ("" if args.json else "&format=md"))
            print(json.dumps(v, indent=1) if args.json else v["markdown"], end="" if not args.json else "\n")
            return 0
        if args.brief:
            prov = f"&provider={args.provider}" if args.provider else ""
            print(call("GET", f"/api/projects/{pid}/brief?{frm}&role={args.brief}{prov}")["brief"], end="")
            return 0
        if args.fold:
            r = call("POST", f"/api/projects/{pid}/nodes/fold", {})
            for f in r["folded"]:
                print(f"folded {f['agent']} (session {f['session_id'] or '-'}; {f['work_to_lead']} open work item(s) to {r['lead'] or 'nobody'})")
            if r["left_busy"]:
                print("left alone, busy: " + ", ".join(r["left_busy"]))
            if not r["folded"] and not r["left_busy"]:
                print("nothing outside the seats")
            return 0
        if args.pickup:
            r = call("POST", f"/api/projects/{pid}/nodes/{args.pickup}/pickup", {})
            print(f"{args.pickup}: {r['action']} {r['agent']}" + (f" on {r['provider']}/{r['account']} {r.get('model') or 'default model'}"
                                                                   + (" (its own account type had no room)" if r.get("moved") else "")
                                                                   if r["action"] == "started" else ""))
            return 0
        if args.set:
            body = {k: v for k, v in (("model", args.model), ("provider", args.provider), ("agent", args.agent)) if v is not None}
            v = call("POST", f"/api/projects/{pid}/nodes/{args.set}", body)
        else:
            v = call("GET", f"/api/projects/{pid}/nodes?{frm}")
        for n in v["seats"]:
            who = f"{n['agent']} ({n['running_provider']}/{n['account']} {n['running_model']}, idle {n['idle_hours']} h)" if n["agent"] else "nobody"
            print(f"{n['title']:<18} {n['provider']} {n['model']:<18} {who}  [{n['state']}: {n['pickup']}]")
        print("Live Wiki          kept by Switchboard: sb wiki " + pid)
        for x in v["extras"]:
            print(f"outside the seats  {x['agent']} ({x['model']})")
        return 0
    elif args.cmd == "retention":
        if args.pairs:
            call("POST", "/api/settings", {"retention": dict(p.split("=", 1) for p in args.pairs)})
        if args.run:
            print("removed: " + (json.dumps(call("POST", "/api/retention/run", {})["removed"]) or "{}"))
        v = call("GET", "/api/retention")
        print(f"KEPT (clean-up every {v['every_hours']} h; 0 = rule off)")
        for k, val in v["settings"].items():
            print(f"  {k:20} {val}")
        last = v.get("last") or {}
        print(f"LAST CLEAN-UP: {last.get('at') or 'not yet'}  removed {json.dumps(last.get('removed') or {})}")
        print(f"NOW: hub.db {v['sizes']['hub_db_bytes'] / 1e6:.1f} MB; rows " +
              ", ".join(f"{k} {n}" for k, n in v["sizes"]["rows"].items()))
        print("     folders " + ", ".join(f"{k} {d['files']} files {d['bytes'] / 1e6:.1f} MB"
                                           for k, d in v["sizes"]["folders"].items()))
    elif args.cmd == "note":
        call("POST", "/api/notes", {"text": args.text, "from": me(), "project": args.project})
        print("noted for the project's agents")
    elif args.cmd == "summon":
        res = call("POST", "/api/summon", {"beside": args.agent, "task": args.task, "fork": args.fork,
                                           "model": args.model, "title": args.title, "from": me(),
                                           "idem": str(uuid.uuid4())})
        a = res["agent"]
        print(f"{a['id']} on {a['project']}{' (forked)' if res['forked'] else ''}; open: [[open:{a['project']}/{a['id']}]]")
    elif args.cmd == "work":
        return work(args)
    elif args.cmd == "fleet":
        return fleet_cmd(args)
    elif args.cmd == "halt":
        return halt_cmd(args)
    elif args.cmd == "unhalt":
        return unhalt_cmd(args)
    elif args.cmd == "run":
        return run_cmd(args)
    elif args.cmd == "jobs":
        return jobs_cmd(args)
    elif args.cmd == "stop":
        return stop_cmd(args)
    elif args.cmd == "adopt":
        return adopt_cmd(args)
    elif args.cmd == "notify":
        n = call("POST", "/api/notifications", {"agent": me(), "text": args.text,
                 "level": "info" if args.info else "need", "idem": args.idem or 'notify:' + uuid.uuid4().hex}, retries=4)
        print(f"{n['id']} saved for the owner; inbox: {HUB}/#/inbox")
    elif args.cmd == "inbox":
        return inbox_cmd(args)
    elif args.cmd == "ask":
        opts = [o.strip() for o in args.options.split(",") if o.strip()]
        d = call("POST", "/api/decisions", {"agent": me(), "project": args.project, "question": args.question,
                                            "options": opts})
        print(f"{d['id']} filed for the owner; the answer arrives as a message to {me()}")
    elif args.cmd == "reply":
        call("POST", "/api/reply", {"turn": args.turn, "body": args.text})
        print("reply recorded")
    elif args.cmd == "status":
        print(json.dumps(call("GET", f"/api/messages/{args.id}"), indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
