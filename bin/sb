#!/usr/bin/env python3
"""sb — talk to the switchboard hub (127.0.0.1:8802; SB_HUB overrides).

  sb setup                          tell Switchboard which AI subscriptions / API keys you have (or use the web page)
  sb agents                         list agents and their state
  sb projects                       list projects
  sb send <agent|project> "text"     type into that terminal exactly once (project -> its lead); --wait prints the reply
  sb dispatch <project> "task"      start a new agent on a project with this task
  sb sessions ["words"] [--all]     search past Claude/Codex sessions (the owner's asks, titles, folders)
  sb resume <session-id>            make a past session an agent (reuses its agent; new project if none fits)
  sb relaunch <agent> [--model M] [--effort E] [--confirm]
                                    exit an agent's CLI and start it again on the same session with that model
                                    (--confirm: interrupt it if it is working)
  sb subagents [--model haiku] [--hours 72] [--agent a]
                                    recent subagents (Agent tool) and the agent or session that spawned each
  sb clear [agent]                  start the Switchboard chat (or another headless agent) over
  sb context [agent] [--n N]        your project's agents (last ask/reply) + shared notes; or one agent's recent talk
  sb context --search "words"       search every conversation on your project
  sb note "text"                    leave a short note for the other agents on your project
  sb summon <agent> "task" [--fork] side agent beside <agent> (--fork: a copy of its whole conversation)
  sb ask "question" [--options a,b] file a decision for the owner on your project
  sb inbox [--project p] [--json]   (owner / Switchboard chat) every open request agents filed for the owner, per project
  sb inbox done <id> ["answer"]     cross one off: answer a decision, or dismiss it / acknowledge a need with no answer
  sb notify "text" [--info]         put a note in the owner's Switchboard inbox (--info: FYI, no action needed)
  sb reply <turn> "text"            answer a pane pointer you received
  sb status <message-id>            show one message
  sb fleet [--json]                 the fleet: every host, reachable or not, free threads/RAM/VRAM, jobs, untracked
  sb fleet check                    probe every host now (what is unreachable, and why)
  sb fleet show <host>              one host in full (top processes, units, GPUs, desktop lag numbers)
  sb fleet add-host NAME --ssh ALIAS [--desktop] [--order N]   probe it, then add it to ~/.config/switchboard/hosts.json
  sb fleet wsl-keepalive [DISTRO]   the Windows command that keeps a WSL host from stopping when its console closes
  sb halt [--reason "..."] [--host H] [--workloads]
                                    raise HALT on every host: tracked jobs stop, nothing launches; --workloads also
                                    disables every unit matching workload_units (never protected_units)
  sb halt --install-guards | --list-guards | --remove-guards   systemd drop-ins that refuse to start while HALT exists
  sb unhalt [--host H]              lower HALT
  sb run --name NAME [--host H] [--threads N] [--mem GIB] [--gpu GIB] [--hours H] [--cwd DIR] -- command args...
                                    the one way to launch work: placed on the fleet, run as a bounded systemd
                                    unit, tracked under your name (queued with the reason when nothing fits)
  sb jobs [--all] [--project p] [--host h] [--mine]     running jobs (--all adds finished ones)
  sb jobs show <id> [--log N]       placement, resources, state, and the last N log lines (default 40)
  sb stop <id> [--reason "..."]     stop a job (queued or running)
  sb adopt <unit|pid> --name NAME [--host H] [--threads N --mem GIB --gpu GIB]
                                    watch an existing unit as a job without relaunching it (never halted)
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
import uuid

HUB = os.environ.get("SB_HUB", "http://127.0.0.1:8802")


def call(method, path, body=None):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(HUB + path, data=data, method=method, headers={"Content-Type": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read())
    except urllib.error.HTTPError as e:
        try:
            msg = json.loads(e.read()).get("error")
        except ValueError:
            msg = str(e)
        sys.exit(f"sb: {msg}")
    except urllib.error.URLError as e:
        sys.exit(f"sb: hub not reachable at {HUB} ({e.reason}); is switchboard.service running?")


def me():
    if os.environ.get("SB_AGENT"):
        return os.environ["SB_AGENT"]
    pane = os.environ.get("TMUX_PANE")
    if pane:
        try:
            name = subprocess.run(["tmux", "display-message", "-p", "-t", pane, "#{session_name}"],
                                  capture_output=True, text=True, timeout=5).stdout.strip()
            if name:
                return re.sub(r"[^a-z0-9]+", "-", name.lower()).strip("-")
        except (OSError, subprocess.SubprocessError):
            pass
    return "owner"


def ask(q, default=""):
    try:
        v = input(f"{q}{f' [{default}]' if default else ''}: ").strip()
    except EOFError:
        sys.exit(1)
    return v or default


def yes(q, default=True):
    a = ask(q + (" (Y/n)" if default else " (y/N)")).lower()
    return a.startswith("y") if a else default


def setup():
    """The setup page as questions in the terminal. Saves through the hub when it runs, else writes the file."""
    import getpass
    sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))
    from switchboard import config
    det = config.detect()
    print("Switchboard setup: which AI subscriptions and API keys do you have?")
    if config.accounts():
        print("(This replaces your current accounts: " + ", ".join(a["name"] for a in config.accounts()) +
              ". To change one, use the Setup page instead.)")
    print()
    accounts = []
    subs = [("claude", "claude", "Anthropic: Claude Pro/Max subscription (Claude Code)", "claude, then /login"),
            ("codex", "chatgpt", "OpenAI: ChatGPT subscription (Codex CLI)", "codex login"),
            ("gemini", "gemini", "Google: Google account (Gemini CLI)", "gemini, then Login with Google"),
            ("hermes", "hermes", "Nous Research: Hermes Agent (its own models and providers)", "hermes setup")]
    for kind, name, label, login in subs:
        c = det["clis"][kind]
        state = ("logged in" if c["logged_in"] else "installed, not logged in") if c["installed"] else "not installed"
        if yes(f"Use {label}? [{state}]", default=c["logged_in"]):
            accounts.append({"name": name, "kind": kind, "label": label})
            if not c["installed"]:
                print(f"  install it: {c['install']}")
            if not c["logged_in"]:
                print(f"  then log in once: {login}")
    presets = list(config.PRESETS)
    while True:
        print("\nAdd an API key? " + "  ".join(f"{i + 1}) {config.PRESETS[p]['label']}" for i, p in enumerate(presets)))
        pick = ask("number, or Enter to finish")
        if not pick:
            break
        if not pick.isdigit() or not 1 <= int(pick) <= len(presets):
            continue
        preset = presets[int(pick) - 1]
        p = config.PRESETS[preset]
        base = p["base_url"] or ask("Base URL (for example http://localhost:11434/v1)")
        env = p["env"]
        key = ""
        if env and os.environ.get(env) and yes(f"Use the key in ${env}?"):
            key = os.environ[env]
        if not key:
            key = getpass.getpass(f"API key{' (blank if none)' if preset == 'custom' else ''} (hidden): ").strip()
        r = config.test_api({"preset": preset, "base_url": base, "api_key": key})
        models = r.get("models") or p["models"]
        if models:
            print(f"  {len(models)} models: " + ", ".join(models[:30]) + (" …" if len(models) > 30 else ""))
        elif not r["ok"]:
            print(f"  could not list models: {r.get('error')}")
        model = ask("Model", models[0] if len(models) == 1 or preset == "anthropic" else "")
        r = config.test_api({"preset": preset, "base_url": base, "api_key": key, "model": model})
        print("  works" if r["ok"] else f"  test failed: {r.get('error')} (saved anyway; fix it later on the setup page)")
        kind = "api"
        cli = {"anthropic": "claude", "openai": "codex", "google": "gemini"}.get(preset)
        if cli and det["clis"][cli]["installed"] and not yes(f"Run it on Switchboard's built-in agent? (no = {cli} CLI)"):
            kind = cli
        name = config.slug(ask("Name for this account", {"custom": "local"}.get(preset, preset + "-api")))
        a = {"name": name, "kind": kind, "label": p["label"], "api_key": key, "model": model}
        if kind == "api":
            a.update(preset=preset, base_url=base, models=models)
        accounts.append(a)
    if not accounts:
        print("Nothing chosen; nothing saved.")
        return 1
    ws = ask("\nFolder for project folders", config.load().get("workspace") or config.DEFAULT_WORKSPACE)
    body = {"accounts": accounts, "workspace": ws}
    try:
        call("GET", "/api/overview")
    except SystemExit:
        config.set_accounts(accounts, ws)
        print(f"Saved to {config.PATH}. Start Switchboard (./install.sh) and open {HUB}/")
        return 0
    call("POST", "/api/setup", body)
    print(f"Saved. Open {HUB}/ , add a project, then '+ Agent' on its card.")
    return 0


def _gib(mib):
    return "-" if mib is None else f"{mib / 1024:.1f}G"


def fleet_lines(hosts):
    rows = [("HOST", "REACH", "LOAD", "THREADS(free)", "RAM free", "GPUs (free VRAM)", "DESKTOP", "JOBS/UNTRACKED")]
    for h in hosts:
        c = h.get("capacity") or {}
        reach = (f"ok {h['age_s']}s" if h.get("reachable") else "DOWN") if h.get("probed_at") or h.get("error") else "?"
        load = c.get("load")
        groups = {}  # identical cards collapse into one entry: "6x Tesla V100 32.0G 0%"
        for g in c.get("gpus") or []:
            k = (g["name"], bool(g["display"]))
            groups.setdefault(k, []).append(g)
        parts = []
        for (name, disp), gs in groups.items():
            free = min((g["vram_free_mib"] for g in gs if g["vram_free_mib"] is not None), default=None)
            util = max((g["util"] for g in gs if g.get("util") is not None), default=None)
            parts.append((f"{len(gs)}x " if len(gs) > 1 else "") + name.replace("NVIDIA ", "")[:22] + ("*" if disp else "")
                         + f" {_gib(free)}" + (f" {util}%" if util is not None else ""))
        gpus = "; ".join(parts) or "-"
        d = h.get("desktop_metrics") or {}
        desk = f"Xorg {d['xorg_cpu_pct']}% {d['xorg_wakeups_s']}/s" if d else ("desktop" if h.get("desktop") else "-")
        rows.append((h["name"], reach, f"{load[0]:.1f}" if load else "-",
                     f"{c.get('threads', '-')} ({c.get('free_threads', '-')})" if c else "-",
                     f"{c.get('free_ram_gib', '-')}/{c.get('ram_total_gib', '-')}G" if c else "-",
                     gpus, desk, f"{len(h.get('jobs') or [])}/{len(h.get('untracked') or [])}" if c else "-"))
    widths = [max(len(str(r[i])) for r in rows) for i in range(len(rows[0]))]
    out = ["  ".join(str(v).ljust(widths[i]) for i, v in enumerate(r)).rstrip() for r in rows]
    for h in hosts:
        if not h.get("reachable") and h.get("error"):
            out.append(f"  {h['name']}: {h['error']}")
    return out


def fleet_cmd(args):
    act, arg = args.action, args.arg
    if act in ("list", "check"):
        res = call("POST", "/api/fleet/probe", {})["fleet"] if act == "check" else call("GET", "/api/fleet")
        if args.json:
            print(json.dumps(res, indent=1))
            return 0
        print("\n".join(fleet_lines(res["hosts"])))
        if res.get("halt"):
            h = res["halt"]
            print(f"HALT raised by {h['by']} at {h['at']}: {h['reason'] or 'no reason'}  (hosts: {', '.join(h['hosts']) or '-'}"
                  + (f"; still pending: {', '.join(h['pending'])}" if h.get("pending") else "") + ")")
        pl = res.get("placers") or {}
        wb = pl.get("workboard")
        if wb and not wb.get("error"):
            open_jobs = wb.get("jobs") or []
            print(f"gpu-workboard: {len(wb.get('cards') or [])} cards, {len(open_jobs)} open lease(s)/queued"
                  + ("; cpu-run advisor on" if pl.get("cpu_run") else ""))
            for j in open_jobs[:8]:
                print(f"   {j['id']}  {j['status']:<10} {j.get('project') or '-'}/{j.get('label') or '-'}  {j.get('host') or '-'}"
                      + (f"  {j['reason']}" if j.get("reason") else ""))
        elif pl.get("cpu_run"):
            print("cpu-run advisor on")
        if not res["config"]["exists"]:
            print(f"(no hosts file at {res['config']['path']}: this machine only; sb fleet add-host adds more)")
        return 0
    if act == "show":
        res = call("GET", "/api/fleet")
        for h in res["hosts"]:
            if h["name"] == arg:
                print(json.dumps(h, indent=1))
                return 0
        sys.exit(f"sb: no host named {arg}")
    if act == "add-host":
        if not arg:
            sys.exit("sb: sb fleet add-host NAME --ssh ALIAS [--desktop] [--order N]")
        res = call("POST", "/api/fleet/hosts", {"name": arg, "ssh": args.ssh, "desktop": args.desktop, "order": args.order})
        print("\n".join(fleet_lines([res["host"]])))
        print(f"written to {res['config']}")
        return 0
    if act == "wsl-keepalive":
        print(call("GET", "/api/fleet/wsl-keepalive?" + urllib.parse.urlencode({"distro": arg or "Ubuntu"}))["text"])
        return 0
    return 0


def halt_cmd(args):
    if args.list_guards or args.install_guards or args.remove_guards:
        if args.list_guards:
            res = call("GET", "/api/fleet/guards" + (f"?host={','.join(args.host)}" if args.host else ""))
        else:
            res = call("POST", "/api/fleet/guards", {"action": "install" if args.install_guards else "remove",
                                                     "hosts": args.host})
        for r in res["results"]:
            what = {"list": "guarded", "install": "guarded", "remove": "unguarded"}[res["action"]]
            print(f"{r['host']}: {len(r['units'])} {what}" + (f"  ({r['error']})" if r.get("error") else ""))
            for u in r["units"]:
                print(f"   {u}")
        return 0
    res = call("POST", "/api/fleet/halt", {"from": me(), "reason": args.reason, "hosts": args.host,
                                           "workloads": args.workloads})
    for r in res["results"]:
        line = f"{r['host']}: " + ("HALT raised" if r["flag"] else "NOT halted")
        if r["stopped"]:
            line += f"; stopped {len(r['stopped'])} job(s): " + ", ".join(r["stopped"])
        if r["disabled"]:
            line += f"; disabled {len(r['disabled'])}: " + ", ".join(r["disabled"])
        if r["failed"]:
            line += f"; FAILED to disable: " + ", ".join(r["failed"])
        if r.get("error"):
            line += f"  ({r['error']})"
        print(line)
    h = res["halt"]
    if h.get("pending"):
        print(f"pending (unreachable, flagged when they answer): {', '.join(h['pending'])}")
    print("nothing launches through sb run until `sb unhalt`")
    return 0


def _job_line(j):
    res = f"{j['threads']}t {j['mem_mib'] / 1024:.1f}G" + (f" gpu{j['gpu_mib'] / 1024:.1f}G" if j.get("gpu_mib") else "")
    run = "" if j.get("runtime_s") is None else f" {j['runtime_s'] // 3600}h{(j['runtime_s'] % 3600) // 60:02d}m"
    who = "/".join(x for x in (j.get("project"), j.get("agent")) if x)
    tail = f"  {j['reason']}" if j.get("reason") else ""
    via = f"  via {j['placer']}" if j.get("placer") and j["placer"] != "hub" else ""
    via += f" {j['board_id']}" if j.get("board_id") else ""
    via += f"  cpus {','.join(map(str, j['cpus']))}" if j.get("cpus") else ""
    return (f"{j['id']:<14} {j['state']:<9} {j['name']:<22} {j.get('host') or '-':<10} {res:<16}{run:<8} "
            f"{who}{'  adopted' if j.get('adopted') else ''}{via}{tail}")


def run_cmd(args):
    argv = [a for a in args.command if a != "--"] if args.command and args.command[0] == "--" else args.command
    if not argv:
        sys.exit("sb: sb run --name NAME [...] -- command args...")
    b = {"name": args.name, "argv": argv, "cwd": args.cwd or os.getcwd(), "threads": args.threads,
         "mem_mib": int(args.mem * 1024), "hours": args.hours, "host": args.host, "agent": me()}
    if args.gpu:
        b["gpu_mib"] = int(args.gpu * 1024)
    if args.project:
        b["project"] = args.project
    b["lane"], b["protected"] = args.lane, args.protected
    j = call("POST", "/api/jobs", b)
    print(_job_line(j))
    if j["state"] == "queued":
        print("queued: nothing fits right now; the hub retries every probe. `sb fleet` shows what is free, "
              "`sb stop <id>` withdraws it.")
    return 0


def jobs_cmd(args):
    if args.action == "show":
        if not args.arg:
            sys.exit("sb: sb jobs show <id>")
        j = call("GET", f"/api/jobs/{args.arg}?log={args.log}")
        print(_job_line(j))
        print(f"  unit {j['unit']} on {j.get('host')}  cwd {j.get('cwd')}  pid {j.get('pid')}  exit {j.get('exit_code')}")
        print(f"  argv: {' '.join(j['argv'])}")
        print(f"  created {j['created_at']}  started {j.get('started_at')}  finished {j.get('finished_at')}")
        if j.get("log"):
            print("  --- log")
            print("\n".join("  " + l for l in j["log"].splitlines()[-args.log:]))
        return 0
    q = {}
    if args.all:
        q["all"] = "1"
    for k in ("project", "host"):
        if getattr(args, k):
            q[k] = getattr(args, k)
    if args.mine:
        q["agent"] = me()
    res = call("GET", "/api/jobs" + ("?" + urllib.parse.urlencode(q) if q else ""))
    for j in res["jobs"]:
        print(_job_line(j))
    if not res["jobs"]:
        print("no jobs" + ("" if args.all else " running (--all for finished ones)"))
    return 0


def stop_cmd(args):
    j = call("POST", f"/api/jobs/{args.id}/stop", {"from": me(), "reason": args.reason})
    print(_job_line(j))
    return 0


def adopt_cmd(args):
    b = {"name": args.name, "host": args.host, "agent": me(), "project": args.project, "threads": args.threads,
         "mem_mib": int(args.mem * 1024) if args.mem else 0}
    if args.gpu:
        b["gpu_mib"] = int(args.gpu * 1024)
    if args.target.isdigit():
        b["pid"] = int(args.target)
    else:
        b["unit"] = args.target
    j = call("POST", "/api/jobs/adopt", b)
    print(_job_line(j))
    return 0


def inbox_cmd(args):
    if args.action == "done":
        if not args.arg:
            sys.exit("sb: sb inbox done <id> [\"answer\"]")
        r = call("POST", f"/api/inbox/{args.arg}/done", {"answer": args.answer or "", "from": me()})
        print(f"{r['id']}: {r['kind']} {r['state']}" + (f" ({r['answer']})" if r.get("answer") else ""))
        return 0
    res = call("GET", "/api/inbox" + (f"?project={urllib.parse.quote(args.project)}" if args.project else ""))
    if args.json:
        print(json.dumps(res, indent=1))
        return 0
    if not res["items"]:
        print("nothing waits for the owner" + (f" on {args.project}" if args.project else ""))
        return 0
    cur = None
    for x in res["items"]:
        if x["project"] != cur:
            cur = x["project"]
            print(f"== {cur} ({res['by_project'].get(cur, 0)})")
        age = x.get("age_s")
        age_s = f"{age // 86400}d" if age and age >= 86400 else (f"{age // 3600}h" if age and age >= 3600 else f"{(age or 0) // 60}m")
        print(f"{x['id']:<22} {x['kind']:<8} {age_s:>4}  {x['agent'] or '-'}: {x['text'][:160]}")
        if x.get("options"):
            print(f"{'':<22} options: {' | '.join(x['options'])}")
    print(f"{res['count']} waiting; sb inbox done <id> [\"answer\"] crosses one off")
    return 0


def unhalt_cmd(args):
    res = call("POST", "/api/fleet/resume", {"from": me(), "hosts": args.host})
    for r in res["results"]:
        print(f"{r['host']}: " + ("HALT lowered" if r["ok"] else f"not lowered ({r.get('error')})"))
    if res["halt"]:
        print(f"HALT still raised on: {', '.join(res['halt']['hosts'])}")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="sb", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("setup")
    sub.add_parser("agents")
    sub.add_parser("projects")
    s = sub.add_parser("send")
    s.add_argument("to")
    s.add_argument("text", nargs="?", help="message text; '-' or omitted reads stdin")
    s.add_argument("--from", dest="frm")
    s.add_argument("--wait", action="store_true")
    s.add_argument("--timeout", type=int, default=3600)
    d = sub.add_parser("dispatch")
    d.add_argument("project")
    d.add_argument("task")
    d.add_argument("--cwd")
    d.add_argument("--title")
    d.add_argument("--model")
    d.add_argument("--idem")
    ss = sub.add_parser("sessions")
    ss.add_argument("query", nargs="*")
    ss.add_argument("--limit", type=int, default=15)
    ss.add_argument("--all", action="store_true", help="include headless claude -p / codex exec runs")
    rs = sub.add_parser("resume")
    rs.add_argument("session_id")
    rs.add_argument("--project")
    rs.add_argument("--title")
    rl = sub.add_parser("relaunch")
    rl.add_argument("agent")
    rl.add_argument("--model")
    rl.add_argument("--effort")
    rl.add_argument("--confirm", action="store_true")
    sa = sub.add_parser("subagents")
    sa.add_argument("--model")
    sa.add_argument("--hours", type=float, default=72)
    sa.add_argument("--agent")
    sa.add_argument("--limit", type=int, default=15)
    cl = sub.add_parser("clear")
    cl.add_argument("agent", nargs="?", default="desk")
    cx = sub.add_parser("context")
    cx.add_argument("agent", nargs="?")
    cx.add_argument("--project")
    cx.add_argument("--n", type=int, default=12)
    cx.add_argument("--tools", action="store_true")
    cx.add_argument("--search")
    no = sub.add_parser("note")
    no.add_argument("text")
    no.add_argument("--project")
    sm = sub.add_parser("summon")
    sm.add_argument("agent")
    sm.add_argument("task")
    sm.add_argument("--fork", action="store_true")
    sm.add_argument("--model")
    sm.add_argument("--title")
    nt = sub.add_parser("notify")
    nt.add_argument("text")
    nt.add_argument("--info", action="store_true")
    ib = sub.add_parser("inbox")
    ib.add_argument("action", nargs="?", default="list", choices=["list", "done"])
    ib.add_argument("arg", nargs="?", help="the item id (done)")
    ib.add_argument("answer", nargs="?", help="the answer (done); none dismisses or acknowledges")
    ib.add_argument("--project")
    ib.add_argument("--json", action="store_true")
    a = sub.add_parser("ask")
    a.add_argument("question")
    a.add_argument("--options", default="")
    a.add_argument("--project")
    r = sub.add_parser("reply")
    r.add_argument("turn")
    r.add_argument("text")
    st = sub.add_parser("status")
    st.add_argument("id")
    fl = sub.add_parser("fleet")
    fl.add_argument("action", nargs="?", default="list", choices=["list", "check", "show", "add-host", "wsl-keepalive"])
    fl.add_argument("arg", nargs="?", help="host name (show, add-host) or WSL distro (wsl-keepalive)")
    fl.add_argument("--ssh", help="ssh alias from your ~/.ssh/config")
    fl.add_argument("--desktop", action="store_true", help="the owner's display is on this host")
    fl.add_argument("--order", type=int, default=100, help="placement preference, 1 first")
    fl.add_argument("--json", action="store_true")
    ha = sub.add_parser("halt")
    ha.add_argument("--reason", default="")
    ha.add_argument("--host", action="append", help="only these hosts (repeatable)")
    ha.add_argument("--workloads", action="store_true", help="also disable --now every unit matching workload_units")
    ha.add_argument("--install-guards", action="store_true")
    ha.add_argument("--remove-guards", action="store_true")
    ha.add_argument("--list-guards", action="store_true")
    uh = sub.add_parser("unhalt")
    uh.add_argument("--host", action="append")
    rn = sub.add_parser("run")
    rn.add_argument("--name", required=True)
    rn.add_argument("--host")
    rn.add_argument("--threads", type=int, default=1)
    rn.add_argument("--mem", type=float, default=2.0, help="GiB")
    rn.add_argument("--gpu", type=float, help="VRAM in GiB")
    rn.add_argument("--hours", type=float, default=12.0)
    rn.add_argument("--cwd")
    rn.add_argument("--project")
    rn.add_argument("--lane", choices=["batch", "interactive"], default="batch")
    rn.add_argument("--protected", action="store_true", help="opt out of GPU checkpoint preemption (owner's call)")
    rn.add_argument("command", nargs=argparse.REMAINDER)
    jb = sub.add_parser("jobs")
    jb.add_argument("action", nargs="?", default="list", choices=["list", "show"])
    jb.add_argument("arg", nargs="?")
    jb.add_argument("--all", action="store_true")
    jb.add_argument("--mine", action="store_true")
    jb.add_argument("--project")
    jb.add_argument("--host")
    jb.add_argument("--log", type=int, default=40)
    sp = sub.add_parser("stop")
    sp.add_argument("id")
    sp.add_argument("--reason", default="")
    ad = sub.add_parser("adopt")
    ad.add_argument("target", help="a unit name or a pid")
    ad.add_argument("--name", required=True)
    ad.add_argument("--host")
    ad.add_argument("--project")
    ad.add_argument("--threads", type=int, default=0)
    ad.add_argument("--mem", type=float, default=0.0)
    ad.add_argument("--gpu", type=float)
    args = ap.parse_args()
    if args.cmd == "setup":
        return setup()

    if args.cmd == "agents":
        for x in call("GET", "/api/agents")["agents"]:
            print(f"{x['id']:<28} {x['state']:<9} {x['provider']}/{x['account'] or '-':<8} {x['mode']:<9} "
                  f"{x['project'] or '-':<18} {(x['last_text'] or '').splitlines()[-1][:60] if x['last_text'] else ''}")
    elif args.cmd == "projects":
        for p in call("GET", "/api/overview")["projects"]:
            print(f"{p['id']:<22} {len(p['agent_ids'])} agents  {p['next_step'][:80]}")
    elif args.cmd == "send":
        text = args.text if args.text not in (None, "-") else sys.stdin.read()
        sender = args.frm or me()
        res = call("POST", "/api/messages", {"to": args.to, "body": text, "from": sender,
                                             "idem": os.environ.get("SB_IDEM") or str(uuid.uuid4()),
                                             "wait": args.wait,
                                             "hop": int(os.environ.get("SB_HOP", "-1")) + 1})
        m = res["message"]
        print(f"{m['id']} {m['state']}{' (already sent — not sent again)' if res['duplicate'] else ''}")
        if args.wait:
            end = time.time() + args.timeout
            while time.time() < end:
                m = call("GET", f"/api/messages/{m['id']}")
                if m["state"] in ("done", "failed", "held"):
                    print(m["state"])
                    print(m.get("reply") or m.get("error") or "")
                    return 0 if m["state"] == "done" else 1
                time.sleep(3)
            print("still running; check later with: sb status " + m["id"])
            return 2
    elif args.cmd == "dispatch":
        res = call("POST", "/api/dispatch", {"project": args.project, "task": args.task, "cwd": args.cwd,
                                             "title": args.title, "model": args.model, "from": me(),
                                             "idem": args.idem or str(uuid.uuid4())})
        a = res["agent"]
        print(f"{a['id']} on {a['project']} ({a['model']}, {a['account']})"
              f"{' (already dispatched — not started again)' if res['duplicate'] else ''}")
    elif args.cmd == "sessions":
        q = urllib.parse.urlencode({"q": " ".join(args.query), "limit": args.limit, "headless": int(args.all)})
        res = call("GET", f"/api/sessions?{q}")
        for x in res["sessions"]:
            where = f"agent {x['agent']}" if x["agent"] else (f"-> {x['project']}" if x["project"] else "-> new project")
            what = " ".join((x["title"] or x["first_ask"] or "").split())[:60]
            print(f"{x['id']}  {x['provider']:<6} {(x['last_ts'] or '')[:10]}  {what:<60}  {x['cwd']}  [{where}]")
            if x.get("snippet"):
                print(f"    {' '.join(x['snippet'].split())[:150]}")
        if not res["sessions"]:
            print(f"no match among {res['indexed']} sessions" + (" (still indexing)" if res["indexing"] else ""))
    elif args.cmd == "resume":
        res = call("POST", "/api/sessions/resume", {"session_id": args.session_id, "project": args.project,
                                                     "title": args.title})
        a = res["agent"]
        how = "already an agent" if not res["created"] else (
            "new agent on new project" if res["created_project"] else "new agent")
        print(f"{a['id']} on {a['project']} ({how}); open: [[open:{a['project']}/{a['id']}]]")
    elif args.cmd == "relaunch":
        b = {k: getattr(args, k) for k in ("model", "effort") if getattr(args, k) is not None}
        a = call("POST", f"/api/agents/{args.agent}/relaunch", dict(b, confirm=args.confirm))
        how = "next turn" if a["mode"] == "managed" else "relaunching on the same session"
        print(f"{a['id']}: {how} (model {b.get('model') or a['model'] or 'default'}); "
              f"open: [[open:{a['project']}/{a['id']}]]")
    elif args.cmd == "subagents":
        q = {"hours": args.hours, "limit": args.limit}
        q.update({k: getattr(args, k) for k in ("model", "agent") if getattr(args, k)})
        res = call("GET", "/api/subagents?" + urllib.parse.urlencode(q))
        for x in res["subagents"]:
            who = (f"agent {x['agent']} ({x['project']})" if x["agent"]
                   else f"session {x['parent_session'][:8]}" + (f" \"{' '.join(x['session_title'].split())[:50]}\""
                                                                  if x["session_title"] else ""))
            state = "done" if x["finished"] else "running?"
            print(f"{(x['started_at'] or '')[:16].replace('T', ' ')}Z  {x['model'] or '-':<18} {state:<8} "
                  f"\"{x['description'][:50]}\"  spawned by {who} [session {x['parent_session']}]  {x['cwd'] or ''}")
        if not res["subagents"]:
            print(f"no subagents in the last {args.hours:g} h" + (f" matching {args.model}" if args.model else ""))
    elif args.cmd == "clear":
        a = call("POST", f"/api/agents/{args.agent}/clear", {})
        print(f"{a['id']} cleared; its next message starts a new conversation")
    elif args.cmd == "context":
        q = {"from": me()}
        if args.agent:
            q.update(n=args.n, tools=int(args.tools))
            print(call("GET", f"/api/agents/{args.agent}/context?{urllib.parse.urlencode(q)}")["text"])
            return 0
        if args.search:
            q["q"] = args.search
        base = f"/api/projects/{args.project}/context" if args.project else "/api/context"
        res = call("GET", f"{base}?{urllib.parse.urlencode(q)}")
        if args.search:
            for x in res["hits"]:
                print(f"[{(x['ts'] or '')[:16]}] {x['agent']} {'ASKED' if x['role'] == 'user' else 'SAID'}: {x['text']}")
            if not res["hits"]:
                print(f"nothing on project {res['project']} mentions that")
            return 0
        print(f"PROJECT {res['project']}")
        for a in res["agents"]:
            fork = f", fork of {a['forked_from']}" if a["forked_from"] else ""
            print(f"\n{a['id']}{' (you)' if a['you'] else ''} - {a['title']} ({a['provider']} {a['model'] or ''}, "
                  f"{a['state']}{fork})")
            if a["asked"]:
                print(f"  last asked: {a['asked']}")
            if a["said"]:
                print(f"  last said:  {a['said']}")
        if res["notes"]:
            print("\nNOTES")
            for n in res["notes"]:
                print(f"  [{n['created_at'][:16]}] {n['agent']}: {n['text']}")
    elif args.cmd == "note":
        call("POST", "/api/notes", {"text": args.text, "from": me(), "project": args.project})
        print("noted for the project's agents")
    elif args.cmd == "summon":
        res = call("POST", "/api/summon", {"beside": args.agent, "task": args.task, "fork": args.fork,
                                           "model": args.model, "title": args.title, "from": me(),
                                           "idem": str(uuid.uuid4())})
        a = res["agent"]
        print(f"{a['id']} on {a['project']}{' (forked)' if res['forked'] else ''}; open: [[open:{a['project']}/{a['id']}]]")
    elif args.cmd == "fleet":
        return fleet_cmd(args)
    elif args.cmd == "halt":
        return halt_cmd(args)
    elif args.cmd == "unhalt":
        return unhalt_cmd(args)
    elif args.cmd == "run":
        return run_cmd(args)
    elif args.cmd == "jobs":
        return jobs_cmd(args)
    elif args.cmd == "stop":
        return stop_cmd(args)
    elif args.cmd == "adopt":
        return adopt_cmd(args)
    elif args.cmd == "notify":
        n = call("POST", "/api/notifications", {"agent": me(), "text": args.text, "level": "info" if args.info else "need"})
        print(f"{n['id']} in the owner's Switchboard inbox")
    elif args.cmd == "inbox":
        return inbox_cmd(args)
    elif args.cmd == "ask":
        opts = [o.strip() for o in args.options.split(",") if o.strip()]
        d = call("POST", "/api/decisions", {"agent": me(), "project": args.project, "question": args.question,
                                            "options": opts})
        print(f"{d['id']} filed for the owner; the answer arrives as a message to {me()}")
    elif args.cmd == "reply":
        call("POST", "/api/reply", {"turn": args.turn, "body": args.text})
        print("reply recorded")
    elif args.cmd == "status":
        print(json.dumps(call("GET", f"/api/messages/{args.id}"), indent=1))
    return 0


if __name__ == "__main__":
    sys.exit(main())
